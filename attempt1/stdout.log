le = \'#fff\'; c.beginPath(); c.arc(CW-20,CH/4,T/3,0,Math.PI*2); c.fill();\n  c.fillRect(CW-30, CH/4-1,40,T);\n  c.fillStyle = \'#ffd700\'; c.font = \'monospace\'; c.textAlign = \'center\';\n  c.fillText(\'Score: \'+score, CW/2,10);\n}\nfunction updateEnemies(){\n  for(const e of enemies){\n    const ex = e.x * T; const ey = e.y * T;\n    if(e.type===\'rat\'){ e.x += Math.random()*T-0.5; } else if(e.type===\'skeleton\'){ e.x -= Math.random()*T+0.5; }\n  }\n}\nfunction spawnEnemies(){\n  for(let i=0;i<3 && (enemies.length<6);i++){\n    const t = [\'rat\',\'skeleton\',\'mage\'][Math.floor(Math.random()*3)];\n    let ex = Math.random()*CW/T; let ey = Math.random()*CH/T;\n    enemies.push({x:ex,y:ey,type:t,hp:1+(t===\'skeleton\'?2:1),damage:5});\n  }\n}\nfunction gameLoop(){\n  if(showTitle){\n    drawTitle();\n    requestAnimationFrame(gameLoop);\n    showTitle = false;\n    return;\n  }\n  updateEnemies();\n  const rows = Math.floor(py/T);\n  if(rows>=floor*3){\n    floor++; px=0; py=0; spawnEnemies();\n  }\n  drawMinimap(); drawHUD();\n  requestAnimationFrame(gameLoop);\n}\nfunction gameStart(){\n  initAudio();\n  floor = 1; roomX = 2; roomY = 2; px = 0; py = 0; playerHP = 5;\n  enemies = []; spawnEnemies();\n  document.body.innerHTML = \'<canvas id="c" width="800" height="600"></canvas>\';\n}\ngameStart();\n</script>\n</body>\n</html>'
