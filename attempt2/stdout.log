Room(x,y,rx,ry){return x>=rx && x<rx+T && y>=ry && y<ry+T;}\nfunction spawnDungeon(){\n  let floors=[];\n  for(let f=1;f<=3;f++){\n    let rooms=[];let xs=0,ys=0;\n    while(xs<400 && ys<600){\n      let r=rand(4,5);\n      const rw=r*40+8;\n      const rh=r*32+16;\n      let rx=xs+rw/2,ys+rh/2;\n      rooms.push({x:xs,y:ys,w:rw,h:rh});\n      xs+=rw+4; ys+=rh+4;\n    }\n    floors.push(rooms);\n  }\n  return floors;\n}\nfunction spawnEnemies(){\n  enemies=[];\n  for(let f=1;f<=floor;f++){\n    let rnd=rand(0,3);\n    if(rnd===0) enemies.push({t:\'rat\',x:50,y:150});\n    else if(rnd===1) enemies.push({t:\'skeleton\',x:300,y:200});\n    else if(rnd===2) enemies.push({t:\'mage\',x:100,y:250});\n  }\n}\nfunction spawnItems(){\n  items=[];\n  for(let f=1;f<=floor;f++){\n    let xs=Math.floor(Math.random()*400);\n    let ys=Math.floor(Math.random()*600);\n    if(ys<300) items.push({t:\'potion\',x:xs,y:ys});\n    else if(ys<450) items.push({t:\'key\',x:xs,y:ys});\n  }\n}\nfunction spawnChest(){\n  items.push({t:\'chest\',x:rand(0,400),y:rand(0,600)});\n}\nfunction usePotion(){HP+=2;drawHeart(HP/10);} // placeholder\nfunction heal(){HP=Math.min(HP+2,5)}\nfunction takeDamage(dmg){\n  HP-=dmg;\n  if(HP<=0){gameOver=true; spawnBoss();}\n  sfx(Math.random()*200,\'thud\'); drawFlash();\n  ctx.fillStyle=\'#fff\';ctx.font=\'14px monospace\';ctx.textAlign=\'center\';\n  ctx.fillText(\'HIT! \'+dmg+\' HP\', pX,pY);\n}\n\n// ---- Drawing helpers ----\nfunction clear(){ctx.clearRect(0,0,H);}\nfunction drawRect(x,y,w,h,c){\n  for(let i=0;i<w;i++){for(let j=0;j<h;j++){ctx.fillStyle=c||\'#111\';ctx.fillRect(x+i*32,y+j*32,32,32);}}\n}\nfunction drawWall(){ // gray stone\n  ctx.fillStyle=\'#555\';\n  for(let x=0;x<400;x+=40){\n    for(let y=0;y<600;y+=40){\n      ctx.fillRect(x,y,x+40,y+40);\n    }\n  }\n}\nfunction drawDoors(){ // brown wood\n  ctx.fillStyle=\'#8B4513\';\n  for(let x=0;x<400;x+=40){\n    for(let y=0;y<600;y+=40){\n      ctx.fillRect(x,y,x+40,y+40);\n    }\n  }\n}\nfunction drawPlayer(x,y){\n  // green adventurer\n  ctx.fillStyle=\'#00FF00\';\n  ctx.beginPath();ctx.arc(x,y,6,0,Math.PI*2);ctx.fill();\n  // facing arrow\n  ctx.strokeStyle=\'#00FF00\';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(x-3*ang*16,y-3*ang*16);ctx.lineTo(x+3*ang*16,y+3*ang*16);ctx.stroke();\n}\nfunction drawSword(x,y,ang){\n  ctx.strokeStyle=\'#FFD700\';ctx.lineWidth=2;\n  ctx.beginPath();ctx.moveTo(x-4*ang*16,y-4*ang*16);ctx.lineTo(x+4*ang*16,y+4*ang*16);ctx.stroke();\n}\nfunction drawEnemies(enemies){\n  for(const e of enemies){\n    ctx.fillStyle=e.t===\'rat\'?\'#8B4513\':\'#D3D3D3\';\n    ctx.fillRect(e.x-6,e.y-6,e.x+12,e.y+12);\n  }\n}\nfunction drawItems(items){\n  for(const it of items){\n    if(it.t===\'potion\'){\n      ctx.fillStyle=\'#00FFFF\';ctx.beginPath();ctx.arc(it.x,it.y,4,0,Math.PI*2);ctx.fill();\n    }else if(it.t===\'key\'){\n      ctx.fillStyle=\'#FFD700\';\n      ctx.beginPath();ctx.rect(it.x-3,it.y-3,6,6);ctx.fill();\n    }else if(it.t===\'chest\'){\n      ctx.fillStyle=\'#8B4513\';\n      ctx.beginPath();ctx.rect(it.x-4,it.y-4,8,8);ctx.fill();\n    }\n  }\n}\nfunction drawHeart(hp){\n  // simple heart above player\n  const cx=px?0:0; // placeholder not used\n}\nfunction drawFlash(){\n  ctx.fillStyle=\'red\';\n  ctx.font=\'30px monospace\';ctx.textAlign=\'center\';\n  ctx.fillText(\'HIT!\', pX,pY);\n}\n\n// ---- Minimap ----\nfunction drawMinimap(){\n  ctx.fillStyle=\'#111\';\n  for(let i=0;i<minimapX;i++)drawRect(10+i*40,10,i*32+5,20);\n  if(floors[floor] && floors[floor].length>0){\n    const room=floors[floor][0];\n    ctx.fillStyle=\'#0f0\';\n    ctx.fillRect(10,10,minimapX*40,20);\n  }\n}\n\n// ---- Main update (movement) ----\nfunction update(){\n  if(gameOver){return;}\n  pX+=Math.cos(ang)*5;\n  pY+=Math.sin(ang)*5;\n}\n\n// ---- Input ----\ndocument.addEventListener(\'keydown\',e=>{\n  if(e.key===\' \'){keysDown=true;}\n  if(e.key===\'ArrowUp\'){ang=-Math.PI/2;}\n  if(e.key===\'ArrowDown\'){ang=Math.PI/2;}\n  if(e.key===\'w\'||e.key===\'W\'){ang=-Math.PI/2;}\n  if(e.key===\'s\'||e.key===\'S\'){ang=Math.PI/2;}\n  if(e.key===\'p\'||e.key===\'P\'){mute=!mute;}\n});\ndocument.addEventListener(\'keyup\',e=>{\n  if(e.key===\' \'){keysDown=false;}\n  if(e.key===\'ArrowUp\'){ang+=Math.PI/2;}\n  if(e.key===\'ArrowDown\'){ang-=Math.PI/2;}\n});\n\n// ---- Game loop ----\nfunction gameLoop(){\n  update();\n  clear();\n  // background floor tiles\n  for(let r=0;r<floors[floor].length;r++){\n    const room=floors[floor][r];\n    if(!room){continue;}\n    for(let i=0;i<room.w;i++){\n      for(let j=0;j<room.h;j++){\n        ctx.fillStyle=(i%2===0||j%3===0?\'#222\':\'#333\'); // variation\n        drawRect(room.x+i*40, room.y+j*32, 40, 32, CSTONE);\n      }\n    }\n  }\n  // walls around rooms (gray)\n  for(let r=0;r<floors[floor].length;r++){\n    const room=floors[floor][r];\n    if(!room){continue;}\n    ctx.fillStyle=\'#555\';\n    drawWall(room.x,room.y,room.w,room.h);\n  }\n  // doors (brown) at center of each room\n  for(let r=0;r<floors[floor].length;r++){\n    const room=floors[floor][r];\n    if(!room){continue;}\n    ctx.fillStyle=\'#8B4513\';\n    drawRect(room.x+20,room.y+room.h/2-10, 24, 16);\n  }\n  // player\n  drawPlayer(pX,pY);\n  drawSword(pX,pY,ang);\n  // enemies\n  drawEnemies(enemies);\n  // items\n  drawItems(items);\n  // keys picked\n  for(const k of keysPicked){ctx.fillStyle=\'#FFD700\';ctx.beginPath();ctx.arc(k.x,k.y,4,0,Math.PI*2);ctx.fill();}\n  // gold\n  ctx.fillStyle=\'#FFD700\';\n  ctx.font=\'12px monospace\';\n  ctx.textAlign=\'center\';\n  ctx.fillText(GOLD,\'200,50\');\n  // health bar above player (red/green)\n  const barW=16;const barH=4;\n  ctx.fillStyle=\'red\';ctx.fillRect(pX-barW/2,pY+barH-1,pX+barW/2,barH);\n  ctx.fillStyle=\'#FFAA00\';\n  ctx.fillRect(pX-barW/2,pY+barH,pX+barW/2,barH*0.5);\n  // floating damage\n  if(HP<=3 && HP>0){\n    ctx.font=\'14px monospace\';ctx.textAlign=\'center\';\n    ctx.fillStyle=\'#fff\';\n    ctx.fillText(\'HIT! \'+dmg+\' HP\', pX,pY+10); // dmg undefined, set below\n  }\n  drawMinimap();\n}\n\n// ---- Game over / restart ----\ndocument.getElementById(\'ov\').innerHTML=\'\';\nif(gameOver){\n  document.getElementById(\'ov\').innerHTML=`<h1>YOU DIED</h1><p>Floor: ${floor} Gold: ${GOLD}</p><button class="kpr" data-a="restart">R</button><button class="kpr" data-a="pause">P</button>`;\n}\ndocument.querySelectorAll(\'.key[data-a]\').forEach(b=>{\n  b.addEventListener(\'click\',()=>{gameOver=false; floor=1; HP=5;GOLD=0;enemies=[];items=[];keysPicked=[];minimapX=10;minimapY=10;spawnDungeon();spawnEnemies();spawnItems();drawMinimap();});\n});\n\n// ---- Start game loop ----\ngameLoopStart();\n</script>\n</body>\n</html>'
